# Code Security Scanner - Client Environment Variables

# API Configuration
# The base URL for the backend API server
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket Configuration  
# The WebSocket URL for real-time scan updates
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Development Configuration
# Next.js development server port (default: 3000)
PORT=3000

# Optional: Custom hostname for development
# HOSTNAME=localhost

# Build Configuration
# Set to 'production' for production builds
NODE_ENV=development

# Optional: Analytics and Monitoring
# NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id_here

# Optional: Feature Flags
# NEXT_PUBLIC_ENABLE_EXPERIMENTAL_FEATURES=false
