{
  "mcpServers": {
    "playwright": {
      "type": "built-in",
      "description": "Built-in Playwright automation"
    },
    "search": {
      "type": "built-in",
      "description": "Built-in search and regex tools"
    },
    "functions": {
      "type": "built-in",
      "description": "Built-in function analysis tools"
    }
  },
  "tools": {
    "playwright": {
      "name": "playwright",
      "description": "Google search and website text extraction",
      "type": "web",
      "config": {
        "searchEngine": "google",
        "timeout": 30000,
        "extractFullText": true
      },
      "methods": ["search", "extractText"]
    },
    "function-definition": {
      "name": "function-definition",
      "description": "Get function definitions from code",
      "type": "code-analysis",
      "config": {
        "supportedLanguages": ["javascript", "typescript", "python", "java", "go", "rust", "c", "cpp"],
        "includeDocstrings": true,
        "includeParameters": true
      },
      "methods": ["getDefinition", "getFunctionSignature"]
    },
    "regex-search": {
      "name": "regex-search",
      "description": "Regex search across files",
      "type": "file-search",
      "config": {
        "maxFileSize": "10MB",
        "excludeDirectories": ["node_modules", ".git", "dist", "build"],
        "supportBinaryFiles": false
      },
      "methods": ["searchFiles", "searchInFile", "replaceInFiles"]
    },
    "web-search": {
      "name": "web-search",
      "description": "Web search and documentation retrieval",
      "type": "documentation",
      "config": {
        "searchEngine": "google",
        "maxResults": 10,
        "cacheTimeout": 3600
      },
      "methods": ["search", "getDocumentation"]
    }
  },
  "toolCategories": {
    "web": ["playwright"],
    "code-analysis": ["function-definition"],
    "file-search": ["regex-search"],
    "documentation": ["web-search"]
  }
}